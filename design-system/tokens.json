    "weight": 600,
    "labelPx": 14,
    "separatorPx": 1,
    "background": "none",
    "radiusPx": 0
  },
  "callout": {
    "paddingPx": 24,
    "leftRulePx": 3,
    "keyColor": "accent",
    "background": "surface",
    "radiusPx": 0,
    "titlePx": 20,
    "mobileTitlePx": 16
  },
  "typographyLeading": {
    "display": 1.2,
    "heading": 1.3,
    "lead": 1.6,
    "body": 1.75,
    "caption": 1.5
  },
