{
  "name": "Mossbell／墨贝",
  "version": "1.3.1",
  "description": "面向国内面试官和招聘方的 AI 产品经理作品集，出海内容方向。",
  "source": "https://github.com/zarazhangrui/beautiful-html-templates/tree/main/templates/bold-poster",
  "colors": {
    "paper": "#FFFFFF",
    "surface": "#F5F2EF",
    "ink": "#1C1410",
    "accent": "#D8000F",
    "muted": "#6F6660",
    "rule": "#DDD6D0",
    "border": "#968B82",
    "accent-hover": "#B8000D",
    "accent-soft": "#FFF0EF",
    "disabled": "#E8E3DF"
  },
  "cssCustomProperties": {
    "--color-paper": "oklch(1 0 0)",
    "--color-surface": "oklch(0.9626253 0.0051459 67.76315)",
    "--color-ink": "oklch(0.1999555 0.0153648 47.93274)",
    "--color-accent": "oklch(0.5545102 0.2266388 27.98367)",
    "--color-muted": "oklch(0.5167788 0.0147785 56.0399)",
    "--color-rule": "oklch(0.8799772 0.0112605 63.34273)",
    "--color-border": "oklch(0.6437725 0.0186969 61.80158)",
    "--color-accent-hover": "oklch(0.4919797 0.2009269 27.72976)",
    "--color-accent-soft": "oklch(0.9666694 0.0163169 22.07982)",
    "--color-disabled": "oklch(0.9186226 0.0076823 61.44612)",
    "--color-accent-ink": "var(--color-paper)",
    "--color-focus": "var(--color-ink)",
    "--color-error": "var(--color-ink)",
    "--project-accent": "var(--color-ink)",
    "--project-cover-ink": "var(--color-paper)",
    "--font-display": "\"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans SC\", \"IBM Plex Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "--font-body": "var(--font-display)",
    "--font-code": "var(--font-display)",
    "--text-caption": "0.875rem",
    "--text-body": "1rem",
    "--text-lead": "1.25rem",
    "--text-h3": "1.75rem",
    "--text-h2": "2.5rem",
    "--text-h1": "3.5rem",
    "--text-cover": "4rem",
    "--text-display": "var(--text-cover)",
    "--weight-regular": "400",
    "--weight-medium": "500",
    "--weight-semibold": "600",
    "--weight-bold": "700",
    "--leading-display": "1.2",
    "--leading-lead": "1.6",
    "--leading-heading": "1.3",
    "--leading-body": "1.75",
    "--leading-caption": "1.5",
    "--tracking-display": "-0.025em",
    "--space-3xs": "4px",
    "--space-2xs": "8px",
    "--space-xs": "12px",
    "--space-sm": "16px",
    "--space-md": "24px",
    "--space-lg": "32px",
    "--space-xl": "48px",
    "--space-2xl": "64px",
    "--space-3xl": "96px",
    "--radius-card": "4px",
    "--radius-control": "4px",
    "--radius-tag": "var(--radius-card)",
    "--radius-icon": "16px",
    "--radius-icon-mobile": "12px",
    "--rule-thin": "1px",
    "--rule-strong": "2px",
    "--rule-key": "3px",
    "--control-height": "44px",
    "--layout-max": "1120px",
    "--layout-reading": "40rem",
    "--layout-detail": "880px",
    "--layout-project-copy": "32rem",
    "--layout-list": "44rem",
    "--project-side-width": "280px",
    "--evidence-min-width": "200px",
    "--icon-default": "72px",
    "--icon-featured": "96px",
    "--icon-mobile": "48px",
    "--icon-featured-mobile": "56px",
    "--project-grid-gap": "var(--space-lg)",
    "--project-card-padding": "var(--space-md)",
    "--project-cover-ratio": "16 / 9",
    "--project-featured-ratio": "16 / 10",
    "--project-title-size": "var(--text-h3)",
    "--signature-height": "4px",
    "--signature-columns": "3fr 1fr 4fr",
    "--ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "--ease-in": "cubic-bezier(0.7, 0, 0.84, 0)",
    "--ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "--dur-press": "100ms",
    "--dur-fast": "160ms",
    "--dur-base": "240ms"
  },
  "fonts": {
    "loading": "local-only",
    "remoteRequests": false,
    "stack": [
      "PingFang SC",
      "Microsoft YaHei",
      "Noto Sans SC",
      "IBM Plex Sans",
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "sans-serif"
    ],
    "weights": [
      400,
      500,
      600,
      700
    ],
    "numericFeature": "tabular-nums",
    "firstPaint": "本地字体直接渲染，不进行远程字体替换。"
  },
  "spacingPx": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "typePx": {
    "cover": 64,
    "h1": 56,
    "h2": 40,
    "h3": 28,
    "lead": 20,
    "body": 16,
    "caption": 14
  },
  "radiusPx": {
    "card": 4,
    "control": 4,
    "tag": 4,
    "icon": 16,
    "iconMobile": 12
  },
  "canvas1920x1080": {
    "titlePx": [
      64,
      80
    ],
    "bodyPx": [
      28,
      32
    ],
    "captionPx": [
      22,
      24
    ],
    "safeMarginPx": 96
  },
  "colorAliases": {
    "error": "ink",
    "project-accent": "ink",
    "project-cover-ink": "paper"
  },
  "signature": {
    "choice": "A",
    "heightPx": 4,
    "segments": [
      "ink",
      "accent",
      "surface"
    ],
    "ratio": [
      3,
      1,
      4
    ],
    "placement": "每页页眉",
    "wordmark": "Mossbell／墨贝"
  },
  "buttonStates": [
    "default",
    "hover",
    "focus",
    "active",
    "disabled"
  ],
  "error": {
    "colorAlias": "ink",
    "icon": "!",
    "inlineExplanation": true,
    "usesBrandRed": false
  },
  "projectCard": {
    "fields": [
      "icon",
      "name",
      "subtitle",
      "value",
      "time-and-tags",
      "metrics",
      "links"
    ],
    "titlePx": 28,
    "mobileTitlePx": 20,
    "featuredTitlePx": 40,
    "featuredMobileTitlePx": 28,
    "tagStyle": "14px muted text separated by ·",
    "entryOrder": [
      "Demo",
      "GitHub",
      "详情"
    ],
    "externalSuffix": "↗",
    "internalSuffix": "→",
    "hideMissingUrls": true,
    "wholeCardLink": false
  },
  "portfolioLayout": {
    "maxContentPx": 1120,
    "desktopMinGutterPx": 64,
    "mobileGutterPx": 24,
    "featured": "first-row",
    "columns": [
      "96px",
      "minmax(0,1fr)",
      "280px"
    ],
    "columnGapPx": 32,
    "rowPaddingBlockPx": 48,
    "mobileRowPaddingBlockPx": 32,
    "separatorPx": 1,
    "mobileBelowPx": 760,
    "mobileOrder": [
      "name",
      "value",
      "tags",
      "metrics",
      "links"
    ]
  },
  "projectColorPolicy": {
    "cssProperty": "--pc",
    "fallbackCssProperty": "--project-accent",
    "allowedLocations": [
      "icon",
      "thumbnail"
    ],
    "forbiddenLocations": [
      "text",
      "buttons",
      "tags",
      "card-background",
      "page-background"
    ],
    "warmFamilyAttribute": "data-accent-family=\"warm\"",
    "warmIconStrokeAlias": "ink",
    "defaultIconStrokeAlias": "paper",
    "colorsAreIllustrative": true
  },
  "projectColorExamples": [
    {
      "project": "DramaPilot",
      "category": "短剧类",
      "sampleHex": "#5B647A",
      "family": "other"
    },
    {
      "project": "《送灯》AI 动画短片",
      "category": "短剧类",
      "sampleHex": "#716379",
      "family": "other"
    },
    {
      "project": "公积金政策问答",
      "category": "知识库类",
      "sampleHex": "#4F6475",
      "family": "other"
    },
    {
      "project": "MiroFish 消歧 Agent",
      "category": "舆情分析类",
      "sampleHex": "#D8784A",
      "family": "warm"
    },
    {
      "project": "YouTube 评论话题分析",
      "category": "舆情分析类",
      "sampleHex": "#55695F",
      "family": "other"
    }
  ],
  "brandAccentPolicy": {
    "pageRatio": [
      0.03,
      0.05
    ],
    "uses": [
      "primary-action",
      "link",
      "one-key-judgment"
    ],
    "fixedSignatureException": "页眉分段横线",
    "ordinaryLabelsUseAccent": false
  },
  "contrastMinimums": {
    "normalText": 4.5,
    "largeText": 3,
    "focusAndInteractiveBoundary": 3
  },
  "projectIcon": {
    "sizesPx": {
      "default": 72,
      "featured": 96,
      "mobile": 48,
      "featuredMobile": 56
    },
    "radiusToken": "--radius-icon",
    "mobileRadiusToken": "--radius-icon-mobile",
    "viewBox": [
      0,
      0,
      24,
      24
    ],
    "strokeWidth": 1.7,
    "strokeLinecap": "round",
    "strokeLinejoin": "round",
    "glyphPercent": 48,
    "defaultStroke": "paper",
    "warmStroke": "ink"
  },
  "categoryHeader": {
    "background": "surface",
    "radiusPx": 4,
    "paddingPx": 24,
    "mobilePaddingPx": 16,
    "titlePx": 20,
    "mobileTitlePx": 16,
    "weight": 600,
    "descriptionAndCountPx": 14
  },
  "projectMetric": {
    "desktopValuePx": 28,
    "mobileValuePx": 20,
    "weight": 600,
    "labelPx": 14,
    "mobileLayout": "inline on surface",
    "mobileRadiusPx": 4
  },
  "flowStep": {
    "background": "surface",
    "radiusPx": 4,
    "paddingPx": 16,
    "titlePx": 16,
    "weight": 600,
    "descriptionPx": 14,
    "arrowColor": "muted",
    "mobileDirection": "column",
    "mobileArrowRotationDeg": 90
  },
  "evidence": {
