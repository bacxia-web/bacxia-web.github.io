    "scope": "Demo 与数据工具页；作品集首页与复盘页仍用展示层",
    "colors": {
      "bg": "#FAF8F6",
      "line": "#E9E4DF"
    },
    "typePx": {
      "page": 24,
      "card": 17,
      "body": 15,
      "ui": 14,
      "meta": 13,
      "num": 20
    },
    "radiusPx": {
      "card": 10,
      "item": 8,
      "tag": 4,
      "pill": 999
    },
    "controlPx": {
      "desktop": 36,
      "touch": 44,
      "touchBreakpoint": 1000
    },
    "layoutPx": {
      "side": 232,
      "intel": 360,
      "gap": 20,
      "mainPaddingX": 32,
      "mainMax": 1560
    },
    "chartColors": {
